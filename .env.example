# Copie para .env (ignorado pelo Git) — ou deixe o Terraform gerá-lo (gerar_arquivo_env = true).

# URI do usuário administrador (avnadmin) — usada SOMENTE pelo ETL para criar tabelas e carregar dados
DATABASE_URL=postgres://avnadmin:SENHA@HOST.aivencloud.com:PORTA/saude_materna?sslmode=require

# URI do usuário somente leitura — usada pelo dashboard
DASHBOARD_DATABASE_URL=postgres://dashboard_leitor:SENHA@HOST.aivencloud.com:PORTA/saude_materna?sslmode=require
DASHBOARD_DB_USER=dashboard_leitor

# Opcional — Aiven for OpenSearch (busca textual / NoSQL)
OPENSEARCH_URL=https://avnadmin:SENHA@HOST.aivencloud.com:PORTA
OPENSEARCH_INDICE=obitos-maternos

# Opcionais de processamento
# ETL_CHUNK=250000      # linhas por bloco lido do CSV
# ETL_AMOSTRA=1.0       # fração de amostragem (use 0.1 só para testes rápidos)
